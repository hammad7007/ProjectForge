# Copy this file to .env and fill in real values.
# docker compose automatically picks up .env next to docker-compose.yml.

# Your Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# JWT signing secret — any long random string.
# Generate one with:  openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-string-at-least-48-chars
